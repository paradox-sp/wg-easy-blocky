# =============================================================================
# wg-easy-blocky environment configuration
# Copy to `.env` and edit:  cp .env.example .env
# All values are optional — the Dockerfile defaults apply when unset.
# =============================================================================

# --- wg-easy core ------------------------------------------------------------
# Port the Web UI listens on
PORT=51821
# Host the UI binds to
HOST=0.0.0.0
# Set to true to allow HTTP (no TLS) access to the UI
INSECURE=false
# Set to true to disable IPv6 support
DISABLE_IPV6=false
# Set to true to skip the version check against GitHub
DISABLE_VERSION_CHECK=false
# Disable password authentication (use OAuth only)
DISABLE_PASSWORD_AUTH=false

# --- OAuth (optional) ---------------------------------------------------------
# Comma-separated list of enabled providers (e.g. github,google,oidc)
OAUTH_PROVIDERS=
# Comma-separated list of allowed OAuth email domains
OAUTH_ALLOWED_DOMAINS=
# Automatically register users that log in with an OAuth provider
OAUTH_AUTO_REGISTER=false
# Which OAuth provider to auto-launch on the login page
OAUTH_AUTO_LAUNCH=

# --- First-run initialization (optional) --------------------------------------
# Set to true to create the admin user + interface automatically on boot
INIT_ENABLED=false
INIT_USERNAME=
INIT_PASSWORD=
# Comma-separated DNS servers handed to clients (Blocky is the default)
INIT_DNS=
INIT_IPV4_CIDR=
INIT_IPV6_CIDR=
INIT_ALLOWED_IPS=
# Public hostname/IP clients connect to
INIT_HOST=
INIT_PORT=

# --- WireGuard ----------------------------------------------------------------
WG_INTERFACE=wg0
WG_PORT=51820
# DNS handed to clients; 127.0.0.1 routes through Blocky in-container
WG_DNS=127.0.0.1

# --- Blocky DNS ----------------------------------------------------------------
# Set to false to disable the Blocky integration entirely
BLOCKY_ENABLED=true
# Host Blocky's HTTP API listens on (in-container)
BLOCKY_HOST=127.0.0.1
# Path to the Blocky config file (rewritten by the app on save)
BLOCKY_CONFIG=/etc/blocky/config.yml
# Directory where Blocky writes its CSV query logs
BLOCKY_LOG_DIR=/data/blocky/logs
# Port Blocky's HTTP API / metrics listen on
BLOCKY_HTTP_PORT=4000

# --- VictoriaMetrics ------------------------------------------------------------
# Set to false to disable the VictoriaMetrics integration
VM_ENABLED=true
# Base URL of the VictoriaMetrics HTTP API (in-container)
VM_URL=http://127.0.0.1:8428
# Base URL of the VMUI web interface
VMUI_URL=http://127.0.0.1:8428/vmui
# Data directory for time-series storage
VM_DATA_DIR=/data/victoriametrics
# Retention period for stored metrics
VM_RETENTION_PERIOD=30d
# HTTP listen address (VMUI is served here)
VM_HTTP_LISTEN_ADDR=:8428
# Bearer token for scraping wg-easy's /metrics endpoint.
# MUST match the wg-easy metrics password when one is configured
# (Settings → Metrics in the UI), otherwise the wg-easy scrape 401s.
VM_METRICS_TOKEN=