{
  "title": "WireGuard",
  "rows": [
    {
      "title": "Overview",
      "panels": [
        {
          "title": "Connected peers",
          "width": 4,
          "expr": ["wireguard_connected_peers"]
        },
        {
          "title": "Configured peers",
          "width": 4,
          "expr": ["wireguard_configured_peers"]
        },
        {
          "title": "Enabled peers",
          "width": 4,
          "expr": ["wireguard_enabled_peers"]
        }
      ]
    },
    {
      "title": "Traffic",
      "panels": [
        {
          "title": "RX rate",
          "width": 6,
          "expr": ["sum(rate(wireguard_received_bytes[5m]))"]
        },
        {
          "title": "TX rate",
          "width": 6,
          "expr": ["sum(rate(wireguard_sent_bytes[5m]))"]
        }
      ]
    },
    {
      "title": "Per-peer",
      "panels": [
        {
          "title": "RX by peer",
          "width": 6,
          "expr": ["sum(rate(wireguard_received_bytes[5m])) by (name)"]
        },
        {
          "title": "TX by peer",
          "width": 6,
          "expr": ["sum(rate(wireguard_sent_bytes[5m])) by (name)"]
        },
        {
          "title": "Handshake age by peer",
          "width": 12,
          "expr": ["time() - wireguard_latest_handshake_seconds"]
        }
      ]
    }
  ]
}