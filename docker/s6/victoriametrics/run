#!/command/with-contenv sh
exec victoria-metrics \
    -httpListenAddr=${VM_HTTP_LISTEN_ADDR:-:8428} \
    -retentionPeriod=${VM_RETENTION_PERIOD:-30d} \
    -storageDataPath=${VM_DATA_DIR:-/data/victoriametrics} \
    -promscrape.config=/etc/victoriametrics/scrape.yml \
    -vmui.customDashboardsPath=/etc/victoriametrics/dashboards \
    -search.maxPointsPerTimeseries=100000 \
    -search.maxUniqueTimeseries=1000000