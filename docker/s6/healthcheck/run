#!/command/with-contenv sh
# Health check script - runs periodically to verify all services
while true; do
    # Check wg-easy (port 51821)
    if ! curl -sf http://localhost:51821/ >/dev/null 2>&1; then
        echo "wg-easy health check failed"
        exit 1
    fi

    # Check Blocky (port 53 DNS + 4000 HTTP; REST API lives under /api)
    if ! curl -sf http://localhost:4000/api/blocking/status >/dev/null 2>&1; then
        echo "Blocky health check failed"
        exit 1
    fi

    # Check VictoriaMetrics (port 8428)
    if ! curl -sf http://localhost:8428/health >/dev/null 2>&1; then
        echo "VictoriaMetrics health check failed"
        exit 1
    fi

    sleep 30
done